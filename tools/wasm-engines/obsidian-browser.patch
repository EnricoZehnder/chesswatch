+#include <emscripten.h>
+EM_ASYNC_JS(int, js_poll_stop, (), {
+  await new Promise((r) => setTimeout(r, 0));
+  const s = Module.stopFlag | 0;
+  Module.stopFlag = 0;
+  return s;
+});
+EM_JS(void, js_set_searching, (int on), { Module.searching = !!on; });
+
+namespace Threads {
+  void wasmPoll() {
+    static int64_t last = 0;
+    int64_t now = timeMillis();
+    if (now - last < 40)
+      return;
+    last = now;
+    if (js_poll_stop())
+      stopSearch();
+  }
+
+  void waitForSearch(bool waitMain) { (void) waitMain; }
+
+  void startSearch(Search::Settings& settings) {
+    searchSettings = settings;
+    searchStopped = false;
+    for (Search::Thread* st : searchThreads) {
+      st->nodesSearched = 0;
+      st->tbHits = 0;
+      st->completeDepth = 0;
+    }
+    Search::Thread* st = searchThreads[0];
+    st->searching = true;
+    js_set_searching(1);
+    st->startSearch();
+    js_set_searching(0);
+    st->searching = false;
+  }
+
+  void setThreadCount(int threadCount) {
+    if (threadCount > 1)
+      threadCount = 1; // the browser build is single-threaded
+    for (Search::Thread* st : searchThreads)
+      delete st;
+    searchThreads.assign(threadCount, nullptr);
+    for (int i = 0; i < threadCount; i++)
+      searchThreads[i] = new Search::Thread();
+  }
+
+  Search::Settings& getSearchSettings() {
+    return searchSettings;
+  }
+
+  void stopSearch() {
+    searchStopped = true;
+  }
+}
